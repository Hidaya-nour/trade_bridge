# ============================================
# Node / Frontend / Mobile
# ============================================
node_modules/
dist/
build/
.expo/
.expo-shared/
mobile/dist-web/

# ============================================
# Python
# ============================================
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.pyo
*.so
.Python

# ============================================
# Environment files
# ============================================
.env
.env.*
!.env.example

# ============================================
# OS / Editor
# ============================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# Logs
# ============================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pip-log.txt
pip-delete-this-directory.txt

# ============================================
# ML Raw Data (NEVER COMMIT RAW DATA)
# ============================================
ml/data/raw/
ml/data/raw/*.csv
ml/data/raw/*.zip
ml/data/raw/*.tar.gz

# ============================================
# ML Processed Data (Derived, can be regenerated)
# ============================================
ml/data/processed/*.csv
ml/data/processed/*.json
ml/data/processed/*_report.json
ml/data/processed/*metrics.json

# Keep processed folder structure but not files
!ml/data/processed/.gitkeep

# ============================================
# Trained Model Artifacts (CAN BE RE-TRAINED)
# ============================================
ml/models/*.joblib
ml/models/*.pkl
ml/models/*.pickle
ml/models/*.h5
ml/models/*.pt
ml/models/*.onnx
ml/models/*.pth

# Keep models folder structure
!ml/models/.gitkeep

# ============================================
# Jupyter / Notebooks
# ============================================
.ipynb_checkpoints/
*.ipynb
*.html

# ============================================
# Python cache inside ml scripts
# ============================================
ml/scripts/__pycache__/
ml/src/__pycache__/
ml/src/**/__pycache__/

# ============================================
# IDE / Project specific
# ============================================
*.bak
*.tmp
*.cache
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/